# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtual environments
.venv/
venv/
env/

# Secrets - never commit API keys
.env
.env.*
!.env.example

# Local vector store, and precomputed embeddings.
# The cache is rebuilt by build_index.py during deployment rather than
# committed: it is several megabytes, and a new copy on every corpus refresh
# would grow history quickly.
chroma_db/
.chroma/
embeddings.npz

